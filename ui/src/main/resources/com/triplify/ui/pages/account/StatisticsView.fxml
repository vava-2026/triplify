<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.String?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.triplify.ui.pages.account.StatisticsController"
      spacing="20"
>

    <stylesheets>
        <String fx:value="/com/triplify/ui/shared/css/theme.css"/>
        <String fx:value="/com/triplify/ui/pages/account/account.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT" spacing="8">
        <FontIcon iconLiteral="fth-bar-chart" iconSize="24" styleClass="header-icon"/>
        <Label fx:id="titleLabel"/>
    </HBox>

    <GridPane fx:id="statisticsGrid" hgap="12" vgap="12" VBox.vgrow="ALWAYS">
    </GridPane>
</VBox>
