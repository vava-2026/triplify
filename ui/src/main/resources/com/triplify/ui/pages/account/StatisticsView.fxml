<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.triplify.ui.pages.account.StatisticsController"
      styleClass="stats-page"
      stylesheets="@../../shared/css/theme.css, @account.css"
      spacing="20">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Header -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT" spacing="8">
        <FontIcon iconLiteral="fth-bar-chart" iconSize="24" styleClass="header-icon"/>
        <Label text="Travel Statistics"/>
    </HBox>

    <!-- Statistic cards -->
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="20.0" />
            <ColumnConstraints percentWidth="20.0" />
            <ColumnConstraints percentWidth="20.0" />
            <ColumnConstraints percentWidth="20.0" />
            <ColumnConstraints percentWidth="20.0" />
        </columnConstraints>

        <VBox styleClass="stat-card" GridPane.columnIndex="0" alignment="CENTER_LEFT">
            <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>
            <StackPane styleClass="icon-circle, icon-green" maxWidth="40" minWidth="40" maxHeight="40" minHeight="40">
                <FontIcon iconLiteral="fth-globe" iconSize="24" styleClass="card-icon"/>
            </StackPane>
            <Label text="Countries Visited" styleClass="card-label" wrapText="true"/>
            <Label fx:id="countriesValue" text="—" styleClass="card-value"/>
        </VBox>

        <VBox styleClass="stat-card" GridPane.columnIndex="1" alignment="CENTER_LEFT">
            <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>
            <StackPane styleClass="icon-circle, icon-blue" maxWidth="40" minWidth="40" maxHeight="40" minHeight="40">
                <FontIcon iconLiteral="fth-navigation" iconSize="24" styleClass="card-icon"/>
            </StackPane>
            <Label text="Total Trips" styleClass="card-label" wrapText="true"/>
            <Label fx:id="tripsValue" text="—" styleClass="card-value"/>
        </VBox>

        <VBox styleClass="stat-card" GridPane.columnIndex="2" alignment="CENTER_LEFT">
            <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>
            <StackPane styleClass="icon-circle, icon-yellow" maxWidth="40" minWidth="40" maxHeight="40" minHeight="40">
                <FontIcon iconLiteral="fth-triangle" iconSize="24" styleClass="card-icon"/>
            </StackPane>
            <Label text="Places Visited" styleClass="card-label" wrapText="true"/>
            <Label fx:id="placesValue" text="—" styleClass="card-value"/>
        </VBox>

        <VBox styleClass="stat-card" GridPane.columnIndex="3" alignment="CENTER_LEFT">
            <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>
            <StackPane styleClass="icon-circle, icon-purple" maxWidth="40" minWidth="40" maxHeight="40" minHeight="40">
                <FontIcon iconLiteral="fth-calendar" iconSize="24" styleClass="card-icon"/>
            </StackPane>
            <Label text="Travel Days" styleClass="card-label" wrapText="true"/>
            <Label fx:id="travelDaysValue" text="—" styleClass="card-value"/>
        </VBox>

        <VBox styleClass="stat-card" GridPane.columnIndex="4" alignment="CENTER_LEFT">
            <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>
            <StackPane styleClass="icon-circle, icon-pink" maxWidth="40" minWidth="40" maxHeight="40" minHeight="40">
                <FontIcon iconLiteral="fth-image" iconSize="24" styleClass="card-icon"/>
            </StackPane>
            <Label text="Photos Uploaded" styleClass="card-label" wrapText="true"/>
            <Label fx:id="photosValue" text="—" styleClass="card-value"/>
        </VBox>
    </GridPane>
</VBox>