<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.triplify.ui.pages.categories.CategoriesController"
           styleClass="page-root,categories-root">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/categories/categories.css"/>
    </stylesheets>

    <VBox spacing="14" maxWidth="1120" styleClass="categories-content">
        <GridPane styleClass="categories-layout">
            <columnConstraints>
                <ColumnConstraints minWidth="360" prefWidth="360" maxWidth="360" hgrow="NEVER"/>
                <ColumnConstraints minWidth="520" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <VBox spacing="14" styleClass="page-card,categories-form-card" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
                <HBox styleClass="categories-card-header">
                    <Label fx:id="formSectionTitleLabel" text="Category Details" styleClass="categories-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="modeBadgeLabel" text="Create mode" styleClass="categories-mode-badge"/>
                </HBox>

                <VBox spacing="6" styleClass="categories-form-group">
                    <Label fx:id="nameLabel" text="English Name *" styleClass="form-label"/>
                    <VBox fx:id="nameInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="categories-form-group">
                    <Label fx:id="nameSkLabel" text="Slovak Name *" styleClass="form-label"/>
                    <VBox fx:id="nameSkInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="categories-form-group">
                    <Label fx:id="descriptionLabel" text="Description" styleClass="form-label"/>
                    <VBox fx:id="descriptionInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="categories-form-group">
                    <Label fx:id="descriptionSkLabel" text="Description (SK)" styleClass="form-label"/>
                    <VBox fx:id="descriptionSkInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="categories-form-group">
                    <Label fx:id="emojiLabel" text="Emoji *" styleClass="form-label"/>
                    <VBox fx:id="emojiInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="categories-form-group">
                    <Label fx:id="colorLabel" text="Theme Color *" styleClass="form-label"/>
                    <VBox fx:id="colorSelectContainer"/>
                </VBox>

                <HBox spacing="10" styleClass="categories-actions-row">
                    <Button fx:id="saveButton"
                            text="Create"
                            onAction="#onSaveCategory"
                            styleClass="app-btn,app-btn-primary,categories-grow-btn"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="clearFormButton"
                            text="Clear"
                            onAction="#onClearForm"
                            styleClass="app-btn,app-btn-secondary"/>
                </HBox>

                <HBox spacing="10" styleClass="categories-actions-row">
                    <Button fx:id="deleteButton"
                            text="Delete"
                            onAction="#onDeleteCategory"
                            styleClass="app-btn,app-btn-danger-outline,categories-grow-btn"
                            HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="14" styleClass="page-card,categories-list-card" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                <HBox styleClass="categories-card-header">
                    <Label text="Category Directory" styleClass="categories-section-title"/>
                </HBox>

                <HBox spacing="10" styleClass="categories-search-row">
                    <HBox fx:id="searchContainer" spacing="10" HBox.hgrow="ALWAYS"/>
                </HBox>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            styleClass="categories-list-scroll">
                    <content>
                        <VBox spacing="10">
                            <VBox fx:id="categoriesListContainer" spacing="10" styleClass="categories-list"/>

                            <Label fx:id="emptyStateLabel"
                                   text="No categories found."
                                   styleClass="categories-empty"
                                   visible="false"
                                   managed="false"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </GridPane>
    </VBox>
</StackPane>
