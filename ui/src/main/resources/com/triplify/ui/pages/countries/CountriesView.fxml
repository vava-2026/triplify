<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
		   xmlns:fx="http://javafx.com/fxml"
		   fx:controller="com.triplify.ui.pages.countries.CountriesController"
		   styleClass="page-root,countries-root">
	<stylesheets>
		<String fx:value="/com/triplify/ui/pages/countries/countries.css"/>
	</stylesheets>

	<VBox spacing="14" maxWidth="1120" styleClass="countries-content">
		<HBox spacing="16" styleClass="countries-layout">
			<VBox spacing="14" styleClass="page-card,countries-form-card">
				<HBox styleClass="countries-card-header">
					<Label fx:id="formSectionTitleLabel" text="Country Details" styleClass="countries-section-title"/>
					<Region HBox.hgrow="ALWAYS"/>
					<Label fx:id="modeBadgeLabel" text="Create mode" styleClass="countries-mode-badge"/>
				</HBox>

				<VBox spacing="6" styleClass="countries-form-group">
                    <Label fx:id="nameLabel" text="English Name *" styleClass="form-label"/>
                    <VBox fx:id="nameInputContainer"/>
                </VBox>

				<VBox spacing="6" styleClass="countries-form-group">
					<Label fx:id="nameSkLabel" text="Slovak Name *" styleClass="form-label"/>
					<VBox fx:id="nameSkInputContainer"/>
				</VBox>

				<VBox spacing="6" styleClass="countries-form-group">
					<Label fx:id="emojiLabel" text="Emoji *" styleClass="form-label"/>
					<VBox fx:id="emojiInputContainer"/>
				</VBox>

				<HBox spacing="10" styleClass="countries-actions-rw">
					<Button fx:id="saveButton"
							text="Create"
							onAction="#onSaveCountry"
							styleClass="app-btn,app-btn-primary,countries-grow-btn"
							HBox.hgrow="ALWAYS"/>
					<Button fx:id="clearFormButton"
							text="Clear"
							onAction="#onClearForm"
							styleClass="app-btn,app-btn-secondary"/>
				</HBox>

				<HBox spacing="10" styleClass="countries-actions-row">
					<Button fx:id="toggleAvailabilityButton"
							text="Ban"
							onAction="#onToggleAvailability"
							styleClass="app-btn,app-btn-tint,countries-grow-btn"
							HBox.hgrow="ALWAYS"/>
					<Button fx:id="deleteButton"
							text="Delete"
							onAction="#onDeleteCountry"
							styleClass="app-btn,app-btn-danger-outline"/>
				</HBox>
            </VBox>

            <VBox spacing="14" styleClass="page-card,countries-list-card" HBox.hgrow="ALWAYS">
				<HBox styleClass="countries-card-header">
					<Label fx:id="listSectionTitleLabel" text="Country Directory" styleClass="countries-section-title"/>
					<Region HBox.hgrow="ALWAYS"/>
					<Button fx:id="loadMoreButton"
							text="Load More"
							onAction="#onLoadMore"
							styleClass="app-btn,app-btn-ghost"/>
				</HBox>

				<HBox fx:id="searchContainer" spacing="10" styleClass="countries-search-row">
				</HBox>

				<ScrollPane fitToWidth="true"
							 hbarPolicy="NEVER"
							 vbarPolicy="AS_NEEDED"
							 VBox.vgrow="ALWAYS"
							 styleClass="countries-list-scroll">
					<content>
						<VBox spacing="10">
							<VBox fx:id="countriesListContainer" spacing="10" styleClass="countries-list"/>

							<Label fx:id="emptyStateLabel"
								   text="No countries found."
								   styleClass="countries-empty"
								   visible="false"
								   managed="false"/>
						</VBox>
					</content>
				</ScrollPane>
			</VBox>
		</HBox>
	</VBox>
</StackPane>
