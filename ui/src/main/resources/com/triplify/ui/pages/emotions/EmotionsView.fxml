<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.triplify.ui.pages.emotions.EmotionsController"
           styleClass="page-root,emotions-root">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/emotions/emotions.css"/>
    </stylesheets>

    <VBox spacing="14" maxWidth="1120" styleClass="emotions-content">
        <GridPane styleClass="emotions-layout">
            <columnConstraints>
                <ColumnConstraints minWidth="330" prefWidth="330" maxWidth="330" hgrow="NEVER"/>
                <ColumnConstraints minWidth="520" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <VBox spacing="14" styleClass="page-card,emotions-form-card" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
                <HBox styleClass="emotions-card-header">
                    <Label fx:id="formSectionTitleLabel" text="Emotion Details" styleClass="emotions-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="modeBadgeLabel" text="Create mode" styleClass="emotions-mode-badge"/>
                </HBox>

                <VBox spacing="6" styleClass="emotions-form-group">
                    <Label fx:id="nameLabel" text="English Name *" styleClass="form-label"/>
                    <VBox fx:id="nameInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="emotions-form-group">
                    <Label fx:id="nameSkLabel" text="Slovak Name *" styleClass="form-label"/>
                    <VBox fx:id="nameSkInputContainer"/>
                </VBox>

                <VBox spacing="6" styleClass="emotions-form-group">
                    <Label fx:id="emojiLabel" text="Emoji *" styleClass="form-label"/>
                    <VBox fx:id="emojiInputContainer"/>
                </VBox>

                <HBox spacing="10" styleClass="emotions-actions-row">
                    <Button fx:id="saveButton"
                            text="Create"
                            onAction="#onSaveEmotion"
                            styleClass="app-btn,app-btn-primary,emotions-grow-btn"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="clearFormButton"
                            text="Clear"
                            onAction="#onClearForm"
                            styleClass="app-btn,app-btn-secondary"/>
                </HBox>

                <HBox spacing="10" styleClass="emotions-actions-row">
                    <Button fx:id="deleteButton"
                            text="Delete"
                            onAction="#onDeleteEmotion"
                            styleClass="app-btn,app-btn-danger-outline,emotions-grow-btn"
                            HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="14" styleClass="page-card,emotions-list-card" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                <HBox styleClass="emotions-card-header">
                    <Label fx:id="listSectionTitleLabel" text="Emotion Directory" styleClass="emotions-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="loadMoreButton"
                            text="Load More"
                            onAction="#onLoadMore"
                            styleClass="app-btn,app-btn-ghost"/>
                </HBox>

                <HBox fx:id="searchContainer" spacing="10" styleClass="emotions-search-row"/>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            styleClass="emotions-list-scroll">
                    <content>
                        <VBox spacing="10">
                            <VBox fx:id="emotionsListContainer" spacing="10" styleClass="emotions-list"/>

                            <Label fx:id="emptyStateLabel"
                                   text="No emotions found."
                                   styleClass="emotions-empty"
                                   visible="false"
                                   managed="false"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </GridPane>
    </VBox>
</StackPane>
