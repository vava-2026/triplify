<?xml version="1.0" encoding="UTF-8"?>

<?import com.triplify.ui.shared.component.upload_panel.view.ImageUploadPanelView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           styleClass="image-modal-root">
    <Region styleClass="image-modal-backdrop" maxWidth="Infinity" maxHeight="Infinity"/>

    <StackPane styleClass="image-modal-card-shell"
               minWidth="520" prefWidth="520" maxWidth="520"
               alignment="CENTER">
        <VBox fx:id="card" styleClass="image-modal-card"
              minWidth="520" prefWidth="520" maxWidth="520">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>
            <VBox spacing="16">
                <ImageUploadPanelView fx:id="uploadPanel"
                                      minWidth="464" prefWidth="464" maxWidth="464"
                                      minHeight="240" prefHeight="240" maxHeight="240"/>
                <VBox fx:id="descriptionContainer" spacing="0"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="image-modal-actions">
                <padding>
                    <Insets top="20" right="0" bottom="0" left="0"/>
                </padding>
                <StackPane fx:id="cancelButtonContainer"/>
                <StackPane fx:id="saveButtonContainer"/>
            </HBox>
        </VBox>

        <Button fx:id="closeButton" styleClass="image-modal-close-btn" focusTraversable="false"
                StackPane.alignment="TOP_RIGHT">
            <graphic>
                <FontIcon iconLiteral="fth-x" iconSize="18" styleClass="image-modal-close-icon"/>
            </graphic>
            <StackPane.margin>
                <Insets top="12" right="12" bottom="0" left="0"/>
            </StackPane.margin>
        </Button>
    </StackPane>
</StackPane>
