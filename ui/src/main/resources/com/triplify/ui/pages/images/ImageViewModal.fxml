<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           styleClass="image-modal-root">
    <Region styleClass="image-modal-backdrop" maxWidth="Infinity" maxHeight="Infinity"/>

    <StackPane styleClass="image-modal-card-shell"
               minWidth="620" prefWidth="620" maxWidth="620"
               alignment="CENTER">
        <VBox fx:id="card" styleClass="image-modal-card"
              minWidth="620" prefWidth="620" maxWidth="620">
            <ImageView fx:id="imageView"
                       fitWidth="620" preserveRatio="true" smooth="true"/>
            <VBox spacing="8">
                <padding>
                    <Insets top="16" right="24" bottom="20" left="24"/>
                </padding>
                <ScrollPane fitToWidth="true" styleClass="image-modal-desc-scroll"
                            minHeight="0" prefHeight="80" maxHeight="160">
                    <Label fx:id="descriptionLabel" styleClass="image-modal-description"
                           maxWidth="Infinity" wrapText="true"/>
                </ScrollPane>
            </VBox>
        </VBox>

        <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT" spacing="4">
            <StackPane.margin>
                <Insets top="12" right="12" bottom="0" left="0"/>
            </StackPane.margin>
            <Button fx:id="deleteButton" styleClass="image-modal-delete-btn" focusTraversable="false">
                <graphic>
                    <FontIcon iconLiteral="fth-trash-2" iconSize="18" styleClass="image-modal-delete-icon"/>
                </graphic>
            </Button>
            <Button fx:id="closeButton" styleClass="image-modal-close-btn" focusTraversable="false">
                <graphic>
                    <FontIcon iconLiteral="fth-x" iconSize="18" styleClass="image-modal-close-icon"/>
                </graphic>
            </Button>
        </HBox>
    </StackPane>
</StackPane>
