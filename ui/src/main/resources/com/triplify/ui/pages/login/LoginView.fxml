<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="loginRoot"
      fx:controller="com.triplify.ui.pages.account.LoginController"
      styleClass="login-root"
      stylesheets="@css/login.css"
      spacing="0">

    <fx:include fx:id="authHero"
                source="/com/triplify/ui/shared/component/auth_hero/view/AuthHeroView.fxml"
                HBox.hgrow="ALWAYS" />

    <AnchorPane fx:id="loginFormPane" styleClass="login-form-container" HBox.hgrow="ALWAYS">
        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0">
            <VBox styleClass="login-content-wrapper" maxWidth="650" alignment="CENTER">
                <VBox styleClass="login-heading-block" minHeight="100">
                    <Label fx:id="titleLabel" styleClass="login-title"/>
                    <Label fx:id="subtitleLabel" styleClass="login-subtitle"/>
                </VBox>

                <VBox styleClass="login-field-block" minHeight="100">
                    <Label fx:id="usernameLabel" styleClass="login-field-label"/>
                    <VBox fx:id="usernameInputContainer" minHeight="65"/>
                </VBox>

                <VBox styleClass="login-field-block" minHeight="110" alignment="TOP_CENTER">
                    <HBox styleClass="login-password-row" alignment="CENTER_LEFT">
                        <Label fx:id="passwordLabel" styleClass="login-field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="forgotPasswordLabel" styleClass="login-forgot-password"/>
                    </HBox>
                    <VBox fx:id="passwordInputContainer" minHeight="65"/>
                </VBox>

                <VBox styleClass="login-actions-block">
                    <VBox fx:id="loginButtonContainer"/>
                    <HBox styleClass="login-sign-up-row" alignment="CENTER">
                        <Label fx:id="noAccountLabel" styleClass="login-muted-text"/>
                        <Label fx:id="createAccountLabel" styleClass="login-create-account"/>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>

        <fx:include fx:id="loginLanguageIsland"
                    source="/com/triplify/ui/shared/header/view/LanguageIsland.fxml"
                    AnchorPane.topAnchor="20.0"
                    AnchorPane.rightAnchor="25.0"/>
    </AnchorPane>

</HBox>