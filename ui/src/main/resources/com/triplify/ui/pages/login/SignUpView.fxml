<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="signUpRoot"
      fx:controller="com.triplify.ui.pages.account.SignUpController"
      styleClass="login-root"
      stylesheets="@css/login.css">

    <fx:include fx:id="authHero"
                source="/com/triplify/ui/shared/component/auth_hero/view/AuthHeroView.fxml"
                HBox.hgrow="ALWAYS" />

    <AnchorPane fx:id="signUpFormPane" styleClass="login-form-container" HBox.hgrow="ALWAYS">
        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0">
            <VBox styleClass="signup-content-wrapper" maxWidth="650" alignment="CENTER" spacing="20">
                <VBox styleClass="login-heading-block">
                    <Label fx:id="titleLabel" styleClass="login-title"/>
                    <Label fx:id="subtitleLabel" styleClass="login-subtitle"/>
                </VBox>

                <VBox styleClass="login-field-block">
                    <VBox.margin>
                        <Insets top="-5.0"/>
                    </VBox.margin>
                    <Label fx:id="emailLabel" styleClass="login-field-label"/>
                    <VBox fx:id="emailInputContainer"/>
                </VBox>

                <VBox styleClass="login-field-block">
                    <Label fx:id="usernameLabel" styleClass="login-field-label"/>
                    <VBox fx:id="usernameInputContainer"/>
                </VBox>

                <VBox styleClass="login-field-block" alignment="TOP_CENTER">
                    <HBox styleClass="login-password-row" alignment="CENTER_LEFT">
                        <Label fx:id="passwordLabel" styleClass="login-field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <VBox fx:id="passwordInputContainer"/>
                </VBox>

                <VBox styleClass="login-field-block">
                    <Label fx:id="roleLabel" styleClass="login-field-label"/>
                    <HBox fx:id="roleButtonsContainer" styleClass="signup-role-buttons"/>
                </VBox>

                <VBox styleClass="signup-terms-block">
                    <VBox.margin>
                        <Insets top="-15.0"/>
                    </VBox.margin>
                    <VBox fx:id="termsContainer"/>
                </VBox>

                <VBox styleClass="login-actions-block">
                    <VBox.margin>
                        <Insets top="-20.0"/>
                    </VBox.margin>
                    <VBox fx:id="signUpButtonContainer"/>
                    <HBox styleClass="login-sign-up-row" alignment="CENTER">
                        <Label fx:id="haveAccountLabel" styleClass="login-muted-text"/>
                        <Label fx:id="goToLoginLabel" styleClass="login-create-account"/>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>

        <fx:include fx:id="signUpLanguageIsland"
                    source="/com/triplify/ui/shared/header/view/LanguageIsland.fxml"
                    AnchorPane.topAnchor="20.0"
                    AnchorPane.rightAnchor="25.0"/>
    </AnchorPane>

</HBox>
