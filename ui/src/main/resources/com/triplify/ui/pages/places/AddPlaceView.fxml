<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import com.triplify.ui.shared.component.action_buttons.view.EditorActionButtonsView?>
<?import com.triplify.ui.shared.component.section_header.view.SectionHeaderView?>
<?import com.triplify.ui.shared.component.upload_panel.view.ImageUploadPanelView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.triplify.ui.map.InteractiveMap?>

<ScrollPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.triplify.ui.pages.places.AddPlaceController"
           fitToWidth="true"
           hbarPolicy="NEVER"
           vbarPolicy="AS_NEEDED"
           styleClass="page-scroll">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/places/add_place.css"/>
    </stylesheets>
    <content>
        <StackPane styleClass="page-root,add-place-root">
            <VBox fx:id="contentContainer" styleClass="add-place-content">
                <FlowPane fx:id="contentFlow" styleClass="add-place-flow">
                    <VBox styleClass="add-place-main-column">
                        <VBox styleClass="page-card,add-place-card" spacing="18">
                            <SectionHeaderView fx:id="generalSectionHeader" iconLiteral="fth-info" title="General Information"/>

                            <VBox styleClass="add-place-form-group">
                                <Label fx:id="placeTitleLabel" text="Place Title *" styleClass="form-label"/>
                                <VBox fx:id="titleInputContainer"/>
                            </VBox>

                            <VBox styleClass="add-place-form-group">
                                <Label fx:id="countryLabel" text="Country *" styleClass="form-label"/>
                                <VBox fx:id="countryInputContainer"/>
                            </VBox>

                            <VBox styleClass="add-place-form-group">
                                <Label fx:id="descriptionLabel" text="Description" styleClass="form-label"/>
                                <VBox fx:id="descriptionInputContainer"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="page-card,add-place-card,add-place-map-card" spacing="16">
                            <SectionHeaderView fx:id="locationSectionHeader" iconLiteral="fth-map-pin" title="Location"/>

                            <InteractiveMap fx:id="interactiveMap" />

                            <Label fx:id="mapHelperLabel"
                                   text="Click on the map to pick coordinates. Hold the right mouse button to move, use the wheel, pinch, or buttons to zoom, and pan with two-finger touchpad scrolling."
                                   wrapText="true"
                                   styleClass="add-place-helper-text"/>

                            <Label fx:id="selectedCoordinatesLabel"
                                   styleClass="add-place-coordinate-label"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="add-place-side-column">
                        <VBox styleClass="page-card,add-place-card,add-place-upload-card" spacing="14">
                            <ImageUploadPanelView fx:id="imageUploadPanel"
                                                  sectionIconLiteral="fth-image"
                                                  sectionTitle="Cover Image"
                                                  uploadTitle="Click to upload&#10;or drag and drop"
                                                  uploadSubtitle="SVG, PNG, JPEG"/>
                        </VBox>

                        <EditorActionButtonsView fx:id="actionButtonsView"
                                                 primaryText="Save Place"
                                                 secondaryText="Discard Changes"/>
                    </VBox>
                </FlowPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
