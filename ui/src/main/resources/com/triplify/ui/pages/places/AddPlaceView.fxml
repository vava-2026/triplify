<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.triplify.ui.pages.places.AddPlaceController"
           fitToWidth="true"
           hbarPolicy="NEVER"
           vbarPolicy="AS_NEEDED"
           styleClass="page-scroll">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/places/add_place.css"/>
    </stylesheets>
    <content>
        <StackPane styleClass="page-root,add-place-root">
            <VBox fx:id="contentContainer" styleClass="add-place-content">
                <FlowPane fx:id="contentFlow" styleClass="add-place-flow">
                    <VBox styleClass="add-place-main-column">
                        <VBox styleClass="page-card,add-place-card" spacing="18">
                            <HBox styleClass="add-place-section-header">
                                <FontIcon iconLiteral="fth-info" iconSize="14" styleClass="add-place-section-icon"/>
                                <Label text="General Information" styleClass="add-place-section-title"/>
                            </HBox>

                            <VBox styleClass="add-place-form-group">
                                <Label text="Place Title *" styleClass="form-label"/>
                                <VBox fx:id="titleInputContainer"/>
                            </VBox>

                            <VBox styleClass="add-place-form-group">
                                <Label text="Country *" styleClass="form-label"/>
                                <VBox fx:id="countryInputContainer"/>
                            </VBox>

                            <VBox styleClass="add-place-form-group">
                                <Label text="Description" styleClass="form-label"/>
                                <VBox fx:id="descriptionInputContainer"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="page-card,add-place-card,add-place-map-card" spacing="16">
                            <HBox styleClass="add-place-section-header">
                                <FontIcon iconLiteral="fth-map-pin" iconSize="14" styleClass="add-place-section-icon"/>
                                <Label text="Location" styleClass="add-place-section-title"/>
                            </HBox>

                            <StackPane fx:id="mapShell"
                                       styleClass="add-place-map-shell">
                                <StackPane fx:id="mapContainer"
                                           styleClass="add-place-map-container"/>

                                <Label fx:id="hoveredCountryLabel"
                                       managed="false"
                                       visible="false"
                                       styleClass="add-place-country-label"
                                       StackPane.alignment="TOP_LEFT">
                                    <StackPane.margin>
                                        <Insets top="14" left="14"/>
                                    </StackPane.margin>
                                </Label>

                                <VBox styleClass="add-place-map-controls"
                                      StackPane.alignment="BOTTOM_RIGHT">
                                    <StackPane.margin>
                                        <Insets bottom="14" right="14"/>
                                    </StackPane.margin>
                                    <Button fx:id="recenterButton"
                                            onAction="#onRecenterMap"
                                            styleClass="app-btn,app-btn-secondary,add-place-map-control"/>
                                    <Button fx:id="zoomInButton"
                                            text="+"
                                            onAction="#onZoomIn"
                                            focusTraversable="false"
                                            styleClass="app-btn,app-btn-secondary,add-place-map-control"/>
                                    <Button fx:id="zoomOutButton"
                                            text="-"
                                            onAction="#onZoomOut"
                                            focusTraversable="false"
                                            styleClass="app-btn,app-btn-secondary,add-place-map-control"/>
                                </VBox>
                            </StackPane>

                            <Label text="Click on the map to pick coordinates. Hold the right mouse button to move, use the wheel, pinch, or buttons to zoom, and pan with two-finger touchpad scrolling."
                                   wrapText="true"
                                   styleClass="add-place-helper-text"/>

                            <Label fx:id="selectedCoordinatesLabel"
                                   styleClass="add-place-coordinate-label"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="add-place-side-column">
                        <VBox styleClass="page-card,add-place-card,add-place-upload-card" spacing="14">
                            <HBox styleClass="add-place-section-header">
                                <FontIcon iconLiteral="fth-image" iconSize="14" styleClass="add-place-section-icon"/>
                                <Label text="Cover Image" styleClass="add-place-section-title"/>
                            </HBox>

                            <StackPane fx:id="uploadArea"
                                       onMouseClicked="#onChooseCoverImage"
                                       onDragDropped="#onUploadDragDropped"
                                       onDragExited="#onUploadDragExited"
                                       onDragOver="#onUploadDragOver"
                                       styleClass="add-place-upload-area">
                                <ImageView fx:id="coverPreview"
                                           managed="false"
                                           pickOnBounds="true"
                                           preserveRatio="true"
                                           smooth="true"
                                           visible="false"
                                           styleClass="add-place-cover-preview"/>

                                <VBox fx:id="uploadPlaceholder" styleClass="add-place-upload-placeholder">
                                    <FontIcon iconLiteral="fth-image" iconSize="30" styleClass="add-place-upload-icon"/>
                                    <Label text="Click to upload&#10;or drag and drop"
                                           wrapText="true"
                                           styleClass="add-place-upload-title"/>
                                    <Label text="SVG, PNG, JPEG" styleClass="add-place-upload-subtitle"/>
                                </VBox>
                            </StackPane>

                            <Label fx:id="selectedImageLabel"
                                   managed="false"
                                   visible="false"
                                   styleClass="add-place-helper-text"/>
                        </VBox>

                        <VBox styleClass="add-place-action-group">
                            <Button fx:id="saveButton"
                                    maxWidth="Infinity"
                                    onAction="#onSave"
                                    text="Save Place"
                                    styleClass="app-btn,app-btn-primary,add-place-action-button"/>
                            <Button fx:id="discardButton"
                                    maxWidth="Infinity"
                                    onAction="#onDiscard"
                                    text="Discard Changes"
                                    styleClass="app-btn,app-btn-danger-outline,add-place-action-button"/>
                        </VBox>
                    </VBox>
                </FlowPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
