<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import com.triplify.ui.map.InteractiveMap?>
<?import com.triplify.ui.shared.component.detail_actions.view.DetailActionButtonsView?>
<?import com.triplify.ui.shared.component.section_header.view.SectionHeaderView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.triplify.ui.pages.places.PlaceDetailsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/places/add_place.css"/>
        <String fx:value="/com/triplify/ui/pages/places/place_details.css"/>
        <String fx:value="/com/triplify/ui/pages/trips/css/trips.css"/>
    </stylesheets>
    <content>
        <StackPane styleClass="page-root,place-details-root">
            <VBox fx:id="contentContainer" styleClass="place-details-content" spacing="20">
                <StackPane styleClass="place-details-hero">
                    <ImageView fx:id="heroImageView"
                               fitWidth="1120"
                               fitHeight="320"
                               pickOnBounds="true"
                               preserveRatio="false"
                               styleClass="place-details-hero-image"/>

                    <VBox styleClass="place-details-hero-overlay" spacing="0">
                        <HBox alignment="TOP_LEFT">
                            <Button fx:id="backButton"
                                    onAction="#onBack"
                                    text="Back"
                                    styleClass="place-details-back-button"/>
                        </HBox>
                        <VBox styleClass="place-details-hero-copy" spacing="8">
                            <Label fx:id="placeTitleLabel" styleClass="place-details-title"/>
                            <Label fx:id="placeCountryLabel" styleClass="place-details-country"/>
                        </VBox>
                    </VBox>
                </StackPane>

                <VBox styleClass="place-details-sections" spacing="20">
                    <FlowPane fx:id="topRowFlow" styleClass="place-details-top-row" prefWrapLength="1000">
                        <VBox styleClass="place-details-main-column" spacing="20">
                            <VBox styleClass="page-card,place-details-card,place-details-description-card" spacing="12">
                                <Label fx:id="descriptionTitleLabel" styleClass="place-details-card-title" text="Description"/>
                                <Label fx:id="descriptionValueLabel" styleClass="place-details-description" wrapText="true"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="place-details-side-column" spacing="14">
                            <VBox styleClass="page-card,place-details-card,place-details-map-card" spacing="12">
                                <Label fx:id="mapTitleLabel" styleClass="place-details-card-title" text="Map"/>
                                <InteractiveMap fx:id="placeMap"/>
                            </VBox>

                            <DetailActionButtonsView fx:id="actionButtonsView"/>
                        </VBox>
                    </FlowPane>

                    <VBox styleClass="place-details-associated-sections" spacing="20">
                        <VBox styleClass="place-details-trips-section" spacing="12">
                            <SectionHeaderView fx:id="associatedTripsHeader"
                                               iconLiteral="fth-map-pin"
                                               title="Associated Trips"/>
                            <FlowPane fx:id="associatedTripsFlow" styleClass="place-details-grid"/>
                        </VBox>

                        <VBox styleClass="page-card,place-details-card" spacing="16">
                            <SectionHeaderView fx:id="associatedRoutesHeader"
                                               iconLiteral="fth-map"
                                               title="Associated Routes"/>
                            <FlowPane fx:id="associatedRoutesFlow" styleClass="place-details-grid"/>
                        </VBox>

                        <VBox styleClass="page-card,place-details-card" spacing="16">
                            <SectionHeaderView fx:id="associatedStoriesHeader"
                                               iconLiteral="fth-book-open"
                                               title="Associated Stories"/>
                            <FlowPane fx:id="associatedStoriesFlow" styleClass="place-details-grid"/>
                        </VBox>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
