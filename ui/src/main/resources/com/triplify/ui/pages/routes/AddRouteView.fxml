<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.triplify.ui.pages.routes.AddRouteController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/routes/add_route.css"/>
    </stylesheets>
    <content>
        <StackPane styleClass="page-root,add-route-root">
            <VBox fx:id="contentContainer" styleClass="add-route-content">
                <Label text="Route" styleClass="add-route-page-title"/>

                <FlowPane fx:id="contentFlow" styleClass="add-route-flow">
                    <VBox styleClass="add-route-main-column">
                        <VBox styleClass="page-card,add-route-card" spacing="18">
                            <HBox styleClass="add-route-section-header">
                                <FontIcon iconLiteral="fth-info" iconSize="14" styleClass="add-route-section-icon"/>
                                <Label text="General Information" styleClass="add-route-section-title"/>
                            </HBox>

                            <VBox styleClass="add-route-form-group">
                                <Label text="Route Title *" styleClass="form-label"/>
                                <VBox fx:id="titleInputContainer"/>
                            </VBox>

                            <VBox styleClass="add-route-form-group">
                                <Label text="Description" styleClass="form-label"/>
                                <VBox fx:id="descriptionInputContainer"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="page-card,add-route-card" spacing="16">
                            <HBox styleClass="add-route-section-header">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <FontIcon iconLiteral="fth-map-pin" iconSize="14" styleClass="add-route-section-icon"/>
                                    <Label text="Places to Visit" styleClass="add-route-section-title"/>
                                </HBox>
                                <Label fx:id="routeLengthLabel" text="Length: 0.0km" styleClass="add-route-length-label"/>
                            </HBox>

                            <VBox fx:id="placesListContainer" styleClass="add-route-places-list"/>

                            <Button fx:id="addPlaceButton"
                                    maxWidth="Infinity"
                                    onAction="#onAddPlace"
                                    text="Add Place"
                                    styleClass="app-btn,app-btn-secondary,add-route-add-place-button"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="add-route-side-column">
                        <VBox styleClass="page-card,add-route-card,add-route-upload-card" spacing="14">
                            <HBox styleClass="add-route-section-header">
                                <FontIcon iconLiteral="fth-image" iconSize="14" styleClass="add-route-section-icon"/>
                                <Label text="Cover Image" styleClass="add-route-section-title"/>
                            </HBox>

                            <StackPane fx:id="uploadArea"
                                       onMouseClicked="#onChooseCoverImage"
                                       onDragDropped="#onUploadDragDropped"
                                       onDragExited="#onUploadDragExited"
                                       onDragOver="#onUploadDragOver"
                                       styleClass="add-route-upload-area">
                                <ImageView fx:id="coverPreview"
                                           managed="false"
                                           pickOnBounds="true"
                                           preserveRatio="true"
                                           smooth="true"
                                           visible="false"
                                           styleClass="add-route-cover-preview"/>

                                <VBox fx:id="uploadPlaceholder" styleClass="add-route-upload-placeholder">
                                    <FontIcon iconLiteral="fth-image" iconSize="30" styleClass="add-route-upload-icon"/>
                                    <Label text="Click to upload&#10;or drag and drop"
                                           wrapText="true"
                                           styleClass="add-route-upload-title"/>
                                    <Label text="SVG, PNG, JPEG" styleClass="add-route-upload-subtitle"/>
                                </VBox>
                            </StackPane>

                            <Label fx:id="selectedImageLabel"
                                   managed="false"
                                   visible="false"
                                   styleClass="add-route-helper-text"/>
                        </VBox>

                        <VBox styleClass="add-route-action-group">
                            <Button fx:id="saveButton"
                                    maxWidth="Infinity"
                                    onAction="#onSave"
                                    text="Save Route"
                                    styleClass="app-btn,app-btn-primary,add-route-action-button"/>
                            <Button fx:id="discardButton"
                                    maxWidth="Infinity"
                                    onAction="#onDiscard"
                                    text="Discard Changes"
                                    styleClass="app-btn,app-btn-danger-outline,add-route-action-button"/>
                        </VBox>
                    </VBox>
                </FlowPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
