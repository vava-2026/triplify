<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import com.triplify.ui.map.InteractiveMap?>
<?import com.triplify.ui.shared.component.detail_actions.view.DetailActionButtonsView?>
<?import com.triplify.ui.shared.component.section_header.view.SectionHeaderView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.triplify.ui.pages.routes.RouteDetailsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/places/add_place.css"/>
        <String fx:value="/com/triplify/ui/pages/routes/add_route.css"/>
        <String fx:value="/com/triplify/ui/pages/routes/route_details.css"/>
        <String fx:value="/com/triplify/ui/pages/trips/css/trips.css"/>
    </stylesheets>
    <content>
        <StackPane styleClass="page-root,route-details-root">
            <VBox fx:id="contentContainer" styleClass="route-details-content" spacing="20">
                <StackPane fx:id="heroContainer" styleClass="route-details-hero">
                    <ImageView fx:id="heroImageView"
                               fitWidth="1120"
                               fitHeight="320"
                               pickOnBounds="true"
                               preserveRatio="false"
                               styleClass="route-details-hero-image"/>

                    <VBox styleClass="route-details-hero-overlay" spacing="0">
                        <HBox alignment="TOP_LEFT">
                            <Button fx:id="backButton"
                                    onAction="#onBack"
                                    styleClass="route-details-back-button"/>
                        </HBox>
                        <VBox styleClass="route-details-hero-copy" spacing="8">
                            <Label fx:id="routeTitleLabel" styleClass="route-details-title"/>
                            <Label fx:id="routeSubtitleLabel" styleClass="route-details-subtitle"/>
                        </VBox>
                    </VBox>
                </StackPane>

                <FlowPane fx:id="topRowFlow" styleClass="route-details-top-row" prefWrapLength="1000">
                    <VBox styleClass="route-details-main-column" spacing="20">
                        <VBox styleClass="page-card,route-details-card,route-details-description-card" spacing="12">
                            <Label fx:id="descriptionTitleLabel" styleClass="route-details-card-title"/>
                            <Label fx:id="descriptionValueLabel" styleClass="route-details-description" wrapText="true"/>
                        </VBox>

                        <VBox styleClass="page-card,route-details-card" spacing="14">
                            <SectionHeaderView fx:id="placesHeader" iconLiteral="fth-map-pin"/>
                            <VBox fx:id="placesListContainer" styleClass="route-details-places-list" spacing="12"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="route-details-side-column" spacing="14">
                        <VBox styleClass="page-card,route-details-card,route-details-overview-card" spacing="12">
                            <Label fx:id="overviewTitleLabel" styleClass="route-details-card-title"/>
                            <InteractiveMap fx:id="routeMap"/>
                            <VBox styleClass="route-details-metrics" spacing="8">
                                <Label fx:id="distanceValueLabel" styleClass="route-details-distance-value"/>
                                <Label fx:id="placesValueLabel" styleClass="route-details-places-value"/>
                            </VBox>
                        </VBox>

                        <DetailActionButtonsView fx:id="actionButtonsView"/>
                    </VBox>
                </FlowPane>

                <VBox styleClass="route-details-associated-sections" spacing="20">
                    <VBox styleClass="route-details-associated-section" spacing="12">
                        <SectionHeaderView fx:id="associatedTripsHeader" iconLiteral="fth-briefcase"/>
                        <FlowPane fx:id="associatedTripsFlow" styleClass="route-details-grid"/>
                    </VBox>

                    <VBox styleClass="route-details-associated-section" spacing="12">
                        <SectionHeaderView fx:id="associatedStoriesHeader" iconLiteral="fth-book-open"/>
                        <FlowPane fx:id="associatedStoriesFlow" styleClass="route-details-grid"/>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
