<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.triplify.ui.pages.settings.SettingsController"
           styleClass="page-root">
    <VBox spacing="14" maxWidth="980">
        <Label text="Settings" styleClass="page-title"/>
        <Label text="Customize your travel experience." styleClass="page-subtitle"/>

        <VBox styleClass="page-card" spacing="8">
            <CheckBox text="Enable smart recommendations"/>
            <CheckBox text="Sync calendar events"/>
            <CheckBox text="Use metric units"/>
        </VBox>

        <VBox fx:id="contentDemo" styleClass="page-card" spacing="8">
            <Label text="Select a number" styleClass="page-subtitle"/>
        </VBox>
    </VBox>
</StackPane>
