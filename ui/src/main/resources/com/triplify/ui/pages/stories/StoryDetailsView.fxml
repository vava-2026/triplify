<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import com.triplify.ui.shared.component.detail_actions.view.DetailActionButtonsView?>
<?import com.triplify.ui.shared.component.section_header.view.SectionHeaderView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.triplify.ui.pages.stories.StoryDetailsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">
    <stylesheets>
        <String fx:value="/com/triplify/ui/pages/places/place_details.css"/>
        <String fx:value="/com/triplify/ui/pages/trips/css/trips.css"/>
    </stylesheets>
    <content>
        <StackPane styleClass="page-root,place-details-root">
            <VBox styleClass="place-details-content" spacing="20">
                <HBox alignment="TOP_LEFT">
                    <Button fx:id="backButton"
                            onAction="#onBack"
                            styleClass="place-details-back-button"/>
                </HBox>

                <VBox styleClass="page-card,place-details-card" spacing="16">
                    <Label fx:id="storyTitleLabel" styleClass="place-details-title" wrapText="true"/>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <Label fx:id="storyTimeLabel" styleClass="story-details-time"/>
                        <Label fx:id="storyEmotionLabel" styleClass="story-details-emotion"/>
                    </HBox>

                    <FlowPane fx:id="tagsFlow" hgap="8" vgap="8"/>
                </VBox>

                <VBox styleClass="page-card,place-details-card,place-details-description-card" spacing="12">
                    <Label fx:id="descriptionTitleLabel" styleClass="place-details-card-title"/>
                    <Label fx:id="descriptionValueLabel" styleClass="place-details-description" wrapText="true"/>
                </VBox>

                <VBox styleClass="page-card,place-details-card" spacing="12">
                    <SectionHeaderView fx:id="contextHeader" iconLiteral="fth-link"/>
                    <VBox fx:id="contextContainer" spacing="8"/>
                </VBox>

                <DetailActionButtonsView fx:id="actionButtonsView"/>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
