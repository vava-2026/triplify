<?xml version="1.0" encoding="UTF-8"?>

<?import com.triplify.ui.shared.component.action_buttons.view.EditorActionButtonsView?>
<?import com.triplify.ui.shared.component.section_header.view.SectionHeaderView?>
<?import com.triplify.ui.shared.component.tag_picker.TagPickerItem?>
<?import com.triplify.ui.shared.component.upload_panel.view.ImageUploadPanelView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.triplify.ui.pages.trips.AddTripController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">
    <content>
        <StackPane styleClass="page-root,trip-editor-root">
            <VBox fx:id="contentContainer" styleClass="trip-editor-content">
                <FlowPane fx:id="contentFlow" styleClass="trip-editor-flow">
                    <VBox styleClass="trip-editor-main-column">
                        <VBox styleClass="page-card,trip-editor-card" spacing="18">
                            <SectionHeaderView fx:id="generalSectionHeader"
                                               iconLiteral="fth-info"
                                               title="General Information"/>

                            <VBox styleClass="trip-editor-form-group">
                                <Label fx:id="tripTitleLabel" text="Trip Title *" styleClass="form-label"/>
                                <VBox fx:id="titleInputContainer"/>
                            </VBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label fx:id="countriesLabel" text="Countries *" styleClass="form-label"/>
                                <FlowPane fx:id="countriesFlow" styleClass="trip-editor-chip-flow"/>
                                <HBox styleClass="trip-editor-inline-row">
                                    <VBox fx:id="countrySelectContainer" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addCountryButton"
                                            onAction="#onAddCountry"
                                            text="Add Country"
                                            styleClass="app-btn,app-btn-secondary,trip-editor-inline-button"/>
                                </HBox>
                            </VBox>

                            <HBox styleClass="trip-editor-date-row">
                                <VBox HBox.hgrow="ALWAYS" styleClass="trip-editor-form-group">
                                    <Label fx:id="startDateLabel" text="Start Date" styleClass="form-label"/>
                                    <VBox fx:id="startDateContainer"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" styleClass="trip-editor-form-group">
                                    <Label fx:id="endDateLabel" text="End Date" styleClass="form-label"/>
                                    <VBox fx:id="endDateContainer"/>
                                </VBox>
                            </HBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label fx:id="descriptionLabel" text="Description" styleClass="form-label"/>
                                <VBox fx:id="descriptionInputContainer"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="page-card,trip-editor-card" spacing="16">
                            <SectionHeaderView fx:id="routesSectionHeader"
                                               iconLiteral="fth-map"
                                               title="Planned Routes"/>

                            <FlowPane fx:id="routeListContainer" styleClass="trip-editor-routes-flow"/>

                            <Button fx:id="addRouteButton"
                                    maxWidth="Infinity"
                                    onAction="#onAddRoute"
                                    text="Add Route"
                                    styleClass="app-btn,app-btn-dashed-tint,trip-editor-add-action-button"/>

                            <VBox fx:id="routePickerContainer"
                                  managed="false"
                                  visible="false"
                                  spacing="12">
                                <VBox fx:id="routeSearchContainer"/>
                                <Button fx:id="routeCreateButton"
                                        maxWidth="Infinity"
                                        onAction="#onCreateRoute"
                                        text="Create Route"
                                        styleClass="app-btn,app-btn-tint,trip-editor-picker-create-button"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="page-card,trip-editor-card" spacing="16">
                            <SectionHeaderView fx:id="placesSectionHeader"
                                               iconLiteral="fth-map-pin"
                                               title="Places to Visit"/>

                            <FlowPane fx:id="placesFlow" styleClass="trip-editor-places-flow"/>

                            <Button fx:id="addPlaceButton"
                                    maxWidth="Infinity"
                                    onAction="#onAddPlace"
                                    text="Add Place"
                                    styleClass="app-btn,app-btn-dashed-tint,trip-editor-add-action-button"/>

                            <VBox fx:id="placePickerContainer"
                                  managed="false"
                                  visible="false"
                                  spacing="12">
                                <VBox fx:id="placeSearchContainer"/>
                                <Button fx:id="placeCreateButton"
                                        maxWidth="Infinity"
                                        onAction="#onCreatePlace"
                                        text="Create Place"
                                        styleClass="app-btn,app-btn-tint,trip-editor-picker-create-button"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="trip-editor-side-column">
                        <VBox styleClass="page-card,trip-editor-card,trip-editor-upload-card" spacing="14">
                            <ImageUploadPanelView fx:id="imageUploadPanel"
                                                  sectionIconLiteral="fth-image"
                                                  sectionTitle="Cover Image"
                                                  uploadTitle="Click to upload&#10;or drag and drop"
                                                  uploadSubtitle="SVG, PNG, JPEG"/>
                        </VBox>

                        <VBox styleClass="page-card,trip-editor-card" spacing="18">
                            <SectionHeaderView fx:id="metaSectionHeader"
                                               iconLiteral="fth-tag"
                                               title="Categories &amp; Tags"/>

                            <VBox styleClass="trip-editor-form-group">
                                <Label fx:id="categoryLabel" text="Category" styleClass="form-label"/>
                                <VBox fx:id="categorySelectContainer"/>
                            </VBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label fx:id="tagsLabel" text="Tags" styleClass="form-label"/>
                                <TagPickerItem fx:id="tagPickerInput"
                                               placeholderKey="trip.add.select.tag"
                                               popupTitleKey="trip.add.tag.popupTitle"/>
                            </VBox>
                        </VBox>

                        <EditorActionButtonsView fx:id="actionButtonsView"
                                                 primaryTextKey="trip.add.action.save"
                                                 secondaryTextKey="trip.add.action.discard"/>
                    </VBox>
                </FlowPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
