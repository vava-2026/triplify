<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.triplify.ui.pages.trips.AddTripController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">
    <content>
        <StackPane styleClass="page-root,trip-editor-root">
            <VBox fx:id="contentContainer" styleClass="trip-editor-content">
                <FlowPane fx:id="contentFlow" styleClass="trip-editor-flow">
                    <VBox styleClass="trip-editor-main-column">
                        <VBox styleClass="page-card,trip-editor-card" spacing="18">
                            <HBox styleClass="trip-editor-section-header">
                                <FontIcon iconLiteral="fth-info" iconSize="14" styleClass="trip-editor-section-icon"/>
                                <Label text="General Information" styleClass="trip-editor-section-title"/>
                            </HBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label text="Trip Title *" styleClass="form-label"/>
                                <VBox fx:id="titleInputContainer"/>
                            </VBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label text="Countries *" styleClass="form-label"/>
                                <FlowPane fx:id="countriesFlow" styleClass="trip-editor-chip-flow"/>
                                <HBox styleClass="trip-editor-inline-row">
                                    <VBox fx:id="countrySelectContainer" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addCountryButton"
                                            onAction="#onAddCountry"
                                            text="Add Country"
                                            styleClass="app-btn,app-btn-secondary,trip-editor-inline-button"/>
                                </HBox>
                            </VBox>

                            <HBox styleClass="trip-editor-date-row">
                                <VBox HBox.hgrow="ALWAYS" styleClass="trip-editor-form-group">
                                    <Label text="Start Date" styleClass="form-label"/>
                                    <VBox fx:id="startDateContainer"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" styleClass="trip-editor-form-group">
                                    <Label text="End Date" styleClass="form-label"/>
                                    <VBox fx:id="endDateContainer"/>
                                </VBox>
                            </HBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label text="Description" styleClass="form-label"/>
                                <VBox fx:id="descriptionInputContainer"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="page-card,trip-editor-card" spacing="16">
                            <HBox styleClass="trip-editor-section-header">
                                <FontIcon iconLiteral="fth-map" iconSize="14" styleClass="trip-editor-section-icon"/>
                                <Label text="Planned Routes" styleClass="trip-editor-section-title"/>
                            </HBox>

                            <VBox fx:id="routeListContainer" styleClass="trip-editor-list"/>

                            <Button fx:id="addRouteButton"
                                    maxWidth="Infinity"
                                    onAction="#onAddRoute"
                                    text="Add Route"
                                    styleClass="app-btn,app-btn-secondary,trip-editor-outline-button"/>
                        </VBox>

                        <VBox styleClass="page-card,trip-editor-card" spacing="16">
                            <HBox styleClass="trip-editor-section-header">
                                <FontIcon iconLiteral="fth-map-pin" iconSize="14" styleClass="trip-editor-section-icon"/>
                                <Label text="Places to Visit" styleClass="trip-editor-section-title"/>
                            </HBox>

                            <FlowPane fx:id="placesFlow" styleClass="trip-editor-places-flow"/>

                            <Button fx:id="addPlaceButton"
                                    maxWidth="Infinity"
                                    onAction="#onAddPlace"
                                    text="Add Place"
                                    styleClass="app-btn,app-btn-secondary,trip-editor-outline-button"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="trip-editor-side-column">
                        <VBox styleClass="page-card,trip-editor-card,trip-editor-upload-card" spacing="14">
                            <HBox styleClass="trip-editor-section-header">
                                <FontIcon iconLiteral="fth-image" iconSize="14" styleClass="trip-editor-section-icon"/>
                                <Label text="Cover Image" styleClass="trip-editor-section-title"/>
                            </HBox>

                            <StackPane fx:id="uploadArea"
                                       onMouseClicked="#onChooseCoverImage"
                                       onDragDropped="#onUploadDragDropped"
                                       onDragExited="#onUploadDragExited"
                                       onDragOver="#onUploadDragOver"
                                       styleClass="trip-editor-upload-area">
                                <ImageView fx:id="coverPreview"
                                           managed="false"
                                           pickOnBounds="true"
                                           preserveRatio="true"
                                           smooth="true"
                                           visible="false"
                                           styleClass="trip-editor-cover-preview"/>

                                <VBox fx:id="uploadPlaceholder" styleClass="trip-editor-upload-placeholder">
                                    <FontIcon iconLiteral="fth-image" iconSize="30" styleClass="trip-editor-upload-icon"/>
                                    <Label text="Click to upload&#10;or drag and drop"
                                           wrapText="true"
                                           styleClass="trip-editor-upload-title"/>
                                    <Label text="SVG, PNG, JPEG" styleClass="trip-editor-upload-subtitle"/>
                                </VBox>
                            </StackPane>

                            <Label fx:id="selectedImageLabel"
                                   managed="false"
                                   visible="false"
                                   styleClass="trip-editor-helper-text"/>
                        </VBox>

                        <VBox styleClass="page-card,trip-editor-card" spacing="18">
                            <HBox styleClass="trip-editor-section-header">
                                <FontIcon iconLiteral="fth-tag" iconSize="14" styleClass="trip-editor-section-icon"/>
                                <Label text="Categories &amp; Tags" styleClass="trip-editor-section-title"/>
                            </HBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label text="Category" styleClass="form-label"/>
                                <VBox fx:id="categorySelectContainer"/>
                            </VBox>

                            <VBox styleClass="trip-editor-form-group">
                                <Label text="Tags" styleClass="form-label"/>
                                <VBox fx:id="tagPickerContainer"/>
                            </VBox>
                        </VBox>

                        <VBox styleClass="trip-editor-action-group">
                            <Button fx:id="saveButton"
                                    maxWidth="Infinity"
                                    onAction="#onSave"
                                    text="Save Trip"
                                    styleClass="app-btn,app-btn-primary,trip-editor-action-button"/>
                            <Button fx:id="discardButton"
                                    maxWidth="Infinity"
                                    onAction="#onDiscard"
                                    text="Discard Changes"
                                    styleClass="app-btn,app-btn-danger-outline,trip-editor-action-button"/>
                        </VBox>
                    </VBox>
                </FlowPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
