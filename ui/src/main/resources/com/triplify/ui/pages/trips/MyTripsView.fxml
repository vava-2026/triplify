<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.triplify.ui.pages.trips.MyTripsController"
           styleClass="page-root">
    <VBox spacing="16" maxWidth="1080">
        <Label text="My Trips" styleClass="page-title"/>
        <HBox styleClass="trips-toolbar">
            <HBox styleClass="trips-filters">
                <ComboBox fx:id="countrySelect" promptText="Country" styleClass="trips-filter" prefWidth="130"/>
                <ComboBox fx:id="categorySelect" promptText="Category" styleClass="trips-filter" prefWidth="130"/>
                <ComboBox fx:id="tagSelect" promptText="Tags" styleClass="trips-filter" prefWidth="120"/>
                <ComboBox fx:id="statusSelect" promptText="Status" styleClass="trips-filter" prefWidth="120"/>
                <ComboBox fx:id="startTimeSelect" promptText="Start Time" styleClass="trips-filter" prefWidth="140"/>
            </HBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <HBox styleClass="trips-sort">
                <Label text="Sort by:" styleClass="trips-sort-label"/>
                <ComboBox fx:id="sortSelect" styleClass="trips-filter" prefWidth="140"/>
            </HBox>
        </HBox>

        <ScrollPane fx:id="tripsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="trips-scroll"
                    VBox.vgrow="ALWAYS">
            <GridPane fx:id="tripsGrid" styleClass="trips-grid"/>
        </ScrollPane>
    </VBox>
</StackPane>
