<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         spacing="10"
         styleClass="editor-action-group">

    <Button fx:id="primaryButton"
            maxWidth="Infinity"
            styleClass="app-btn,app-btn-primary,editor-action-button"
            text="Save"/>

    <Button fx:id="secondaryButton"
            maxWidth="Infinity"
            styleClass="app-btn,app-btn-danger-outline,editor-action-button"
            text="Discard Changes"/>

</fx:root>
