<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>


<fx:root type="VBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         styleClass="badge-card"
         stylesheets="@../css/badge.css"
               alignment="TOP_CENTER"
               spacing="0"
               minWidth="160"
               prefWidth="160"
               maxWidth="160"
               minHeight="180"
               prefHeight="180"
               maxHeight="180">

       <padding>
              <Insets top="10" right="30" bottom="10" left="30"/>
       </padding>

       <VBox alignment="TOP_CENTER" spacing="0">
              <ImageView fx:id="badgeImage"
                               fitWidth="100"
                               fitHeight="100"
                               preserveRatio="true"
                               styleClass="badge-image"/>

              <VBox alignment="TOP_CENTER" spacing="0" prefWidth="150" maxWidth="150">
                     <Label fx:id="badgeName"
                               styleClass="badge-name"
                               wrapText="true"
                               alignment="CENTER"
                               minWidth="120"
                               prefWidth="120"
                               maxWidth="120"
                               text="Badge Name"/>

                     <Label fx:id="badgeDescription"
                               styleClass="badge-description"
                               wrapText="true"
                               alignment="CENTER"
                               minWidth="150"
                               prefWidth="150"
                               maxWidth="150"
                               text="Badge Description"/>
              </VBox>
       </VBox>

</fx:root>
