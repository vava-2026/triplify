<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.triplify.ui.shared.component.button.view.ConfirmDialogView"
      styleClass="confirm-dialog"
      spacing="20"
      alignment="CENTER"
      prefWidth="340">

    <Label fx:id="messageLabel" styleClass="confirm-dialog-message" wrapText="true" />

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" styleClass="app-btn,app-btn-secondary" mnemonicParsing="false" onAction="#onCancel" />
        <Button fx:id="confirmBtn" styleClass="app-btn,app-btn-primary" mnemonicParsing="false" onAction="#onConfirm" />
    </HBox>

</VBox>

