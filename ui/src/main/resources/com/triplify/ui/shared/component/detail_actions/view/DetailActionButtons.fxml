<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         spacing="12"
         styleClass="detail-action-group">

    <Button fx:id="primaryButton"
            maxWidth="Infinity"
            styleClass="app-btn,app-btn-primary,detail-action-button"
            text="Edit Place"/>

    <Button fx:id="secondaryButton"
            maxWidth="Infinity"
            styleClass="app-btn,app-btn-danger-outline,detail-action-button"
            text="Delete Place"/>

</fx:root>
