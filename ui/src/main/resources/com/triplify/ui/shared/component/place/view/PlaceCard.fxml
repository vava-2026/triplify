<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.triplify.ui.shared.component.place.view.PlaceCardView"
      fx:id="root"
      spacing="0"
      styleClass="route-card">
    <ImageView fx:id="coverImageView"
               fitWidth="257"
               fitHeight="184"
               pickOnBounds="true"
               preserveRatio="false"
               styleClass="route-card-image"/>

    <VBox spacing="8" styleClass="route-card-body">
        <Label fx:id="titleLabel" styleClass="route-card-title" wrapText="true"/>
        <Label fx:id="countryLabel" styleClass="route-card-places"/>
        <HBox spacing="6" styleClass="route-card-distance-row">
            <FontIcon fx:id="coordIcon" iconLiteral="fth-map-pin" iconSize="14" styleClass="route-card-distance-icon"/>
            <Label fx:id="coordLabel" styleClass="route-card-distance"/>
        </HBox>
    </VBox>
</VBox>
