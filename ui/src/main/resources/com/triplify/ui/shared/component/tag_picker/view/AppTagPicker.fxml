<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <HBox fx:id="shell"
          alignment="CENTER_LEFT"
          styleClass="app-tag-picker-shell">
        <TextField fx:id="inputField"
                   promptText="Choose a tag"
                   maxWidth="Infinity"
                   styleClass="app-tag-picker-input-field"
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearInputButton"
                managed="false"
                visible="false"
                styleClass="app-tag-picker-clear"/>
        <Button fx:id="toggleButton"
                styleClass="app-tag-picker-toggle"/>
    </HBox>

    <FlowPane fx:id="selectedFlow"
              managed="false"
              visible="false"
              hgap="6"
              vgap="6"
              styleClass="app-tag-picker-selected-flow"/>

</fx:root>
