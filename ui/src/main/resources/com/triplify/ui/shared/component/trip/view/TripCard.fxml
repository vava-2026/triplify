<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.triplify.ui.shared.component.trip.view.TripCardView"
      fx:id="root"
      styleClass="trip-card">
    <StackPane fx:id="media" styleClass="trip-card-media">
        <ImageView fx:id="coverImage" styleClass="trip-card-image" preserveRatio="false" smooth="true"/>
        <Label fx:id="statusLabel" styleClass="trip-status" StackPane.alignment="TOP_RIGHT"/>
    </StackPane>
    <VBox spacing="6" styleClass="trip-card-body">
        <Label fx:id="titleLabel" styleClass="trip-title"/>
        <Label fx:id="categoryLabel" styleClass="trip-category"/>
        <HBox spacing="6" styleClass="trip-date-row">
            <FontIcon iconLiteral="fth-calendar" iconSize="14" styleClass="trip-date-icon"/>
            <Label fx:id="dateLabel" styleClass="trip-date"/>
        </HBox>
    </VBox>
</VBox>
