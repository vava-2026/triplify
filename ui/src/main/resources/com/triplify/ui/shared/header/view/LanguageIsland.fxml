<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.triplify.ui.shared.header.view.LanguageIslandView"
      styleClass="language-island"
      alignment="CENTER"
      spacing="3"
      onMouseClicked="#onClicked"
      stylesheets="@../css/header.css">

    <FontIcon iconLiteral="fth-globe" iconSize="20" styleClass="language-icon" />
    <Label fx:id="languageLabel" styleClass="language-label" />

</HBox>

