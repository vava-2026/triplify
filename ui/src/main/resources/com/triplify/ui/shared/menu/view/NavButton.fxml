<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<Button xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.triplify.ui.shared.menu.view.NavButtonView"
        fx:id="button"
        styleClass="nav-btn"
        prefWidth="220" prefHeight="40"
        mnemonicParsing="false"
        onAction="#onClicked">
    <graphic>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <FontIcon fx:id="icon" styleClass="nav-icon" />
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="label" styleClass="nav-label" />
                <Label fx:id="proTag" styleClass="nav-pro-tag" visible="false" managed="false" />
            </HBox>
        </HBox>
    </graphic>
</Button>

