<?xml version="1.0" encoding="UTF-8"?>

<router xmlns="https://github.com/rahulstech/javafx-routing"
        home="start">

    <arguments id="addTripArgs">
        <argument name="tripId" type="string" required="true"/>
        <argument name="tripName" type="string" required="true"/>
    </arguments>

    <arguments id="addPlaceArgs">
        <argument name="tripId" type="string" required="true"/>
        <argument name="tripName" type="string" required="true"/>
    </arguments>

    <arguments id="placeDetailsArgs">
        <argument name="placeId" type="string" required="true"/>
    </arguments>

    <destination id="start"
                 fxml="com/triplify/ui/pages/start/StartPageView.fxml"
                 singleTop="true"/>

    <destination id="login"
                 fxml="com/triplify/ui/pages/login/LoginView.fxml"
                 singleTop="true"/>

    <destination id="sign_up"
                 fxml="com/triplify/ui/pages/login/SignUpView.fxml"
                 singleTop="true"/>

    <destination id="map"
                 fxml="com/triplify/ui/pages/map/MapView.fxml"
                 singleTop="true"/>

    <destination id="my_trips"
                 fxml="com/triplify/ui/pages/trips/MyTripsView.fxml"
                 singleTop="true"/>

    <destination id="add_trip"
                 fxml="com/triplify/ui/pages/trips/AddTripView.fxml"
                 arguments="addTripArgs"
                 singleTop="true"/>

    <destination id="add_place"
                 fxml="com/triplify/ui/pages/places/AddPlaceView.fxml"
                 arguments="addPlaceArgs"
                 singleTop="true"/>

    <destination id="place_details"
                 fxml="com/triplify/ui/pages/places/PlaceDetailsView.fxml"
                 arguments="placeDetailsArgs"
                 singleTop="true"/>

    <destination id="add_route"
                 fxml="com/triplify/ui/pages/routes/AddRouteView.fxml"
                 arguments="addTripArgs"
                 singleTop="true"/>

    <destination id="calendar"
                 fxml="com/triplify/ui/pages/calendar/CalendarView.fxml"
                 singleTop="true"/>

    <destination id="settings"
                 fxml="com/triplify/ui/pages/settings/SettingsView.fxml"
                 singleTop="true"/>

    <destination id="account"
                 fxml="com/triplify/ui/pages/account/AccountView.fxml"
                 singleTop="true"/>
</router>
